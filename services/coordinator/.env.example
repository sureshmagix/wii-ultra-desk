# Development coordinator: binds to 127.0.0.1 only. No production credentials
# or TURN secrets belong in this file.
PORT=4310
WII_COORDINATOR_DB=coordinator.sqlite
# Optional local coturn URLs. The matching WII_TURN_SHARED_SECRET must be
# injected at process launch and is intentionally never written in this file.
# WII_TURN_URLS=turn:127.0.0.1:3478?transport=udp
