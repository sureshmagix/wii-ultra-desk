# Copy to /etc/wii-ultra-desk/staging.env on the VPS. Never store the copy in
# Git. Use unquoted KEY=value lines only: the coturn generator rejects shell
# syntax, placeholders, weak secrets and invalid listener/network values.
#
# Generate WII_TURN_SHARED_SECRET on the VPS, for example:
#   umask 077; openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
# It must be the same secret used by coordinator and generated coturn config.

PORT=4310
WII_COORDINATOR_DB=/var/lib/wii-ultra-desk/coordinator.sqlite

WII_TURN_SHARED_SECRET=REPLACE_WITH_256_BIT_BASE64URL_SECRET
WII_TURN_FQDN=turn.staging.example.invalid
WII_TURN_REALM=turn.staging.example.invalid
WII_TURN_LISTEN_IP=0.0.0.0
# VPS-local relay address. For a directly public VPS it can be its public IPv4.
WII_TURN_RELAY_IP=192.0.2.10
# Set only when the VPS is behind one-to-one NAT; omit on a directly public VPS.
# WII_TURN_PUBLIC_IP=198.51.100.10
WII_TURN_PORT=3478
WII_TURN_TLS_PORT=5349
WII_TURN_RELAY_MIN_PORT=49160
WII_TURN_RELAY_MAX_PORT=49200
WII_TURN_USER_QUOTA=2
WII_TURN_TOTAL_QUOTA=64
# Deploy certificate/key copies readable only by the wii-ultra-turn account.
WII_TURN_TLS_CERT=/etc/wii-ultra-desk/tls/fullchain.pem
WII_TURN_TLS_KEY=/etc/wii-ultra-desk/tls/privkey.pem
WII_TURN_URLS=turn:turn.staging.example.invalid:3478?transport=udp,turn:turn.staging.example.invalid:3478?transport=tcp,turns:turn.staging.example.invalid:5349?transport=tcp
