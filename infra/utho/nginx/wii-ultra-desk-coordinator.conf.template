# Install as a separate server block only after replacing the placeholder with
# the coordinator staging DNS name and checking nginx -T for conflicts.
# TURN must never be added as an HTTP proxy location; coturn owns its UDP/TCP/
# TLS listener ports directly.
server {
    listen 443 ssl http2;
    server_name __COORDINATOR_FQDN__;

    ssl_certificate     /etc/letsencrypt/live/__COORDINATOR_FQDN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__COORDINATOR_FQDN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 16k;

    location = /healthz {
        proxy_pass http://127.0.0.1:4310/healthz;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        proxy_send_timeout 10s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
    }

    location = /v1/connect {
        proxy_pass http://127.0.0.1:4310;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        # Coordinator sessions expire at 15 minutes; leave a small margin.
        proxy_read_timeout 960s;
    }

    location / { return 404; }
}
